{
  "moduleFileExtensions": ["js", "json", "ts", "mjs"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest",
    "^.+\\.mjs$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(better-auth|@thallesp/nestjs-better-auth|@noble/ciphers|@noble/hashes|jose|@better-auth/utils)/)"
  ]
}
